local container=$(docker ps | sed 1d | fzf | cut -d " " -f1)

if [[ -z $container ]]; then
  return
fi

# Try running bash, falling back to sh if unavailable
# Exit code 126 = command found but not executable
# Exit code 127 = command not found
for shell in bash sh
do
  clear
  echo -e "$container - $shell"
  echo  " "
  docker exec -it $container $shell
  local rc=$?
  if [ $rc -ne 126 ] && [ $rc -ne 127 ]; then
    break
  fi
done
