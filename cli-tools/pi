#!/usr/bin/env bash

# Per-repo Pi launcher with a Docker fallback.
#
# Walks up from $PWD (stopping at the git repo root) looking for an executable
# .pi-tool/run and delegates to it (repo-specific launch details live there). If
# none is found, runs pi in Docker against the current directory.
#
#   pi [args...]    run a pi session (args forwarded to pi)
#   pi rebuild      rebuild the fallback Docker image (args go to docker build)
#
# Resuming sessions (sessions are stored per project under the mounted ~/.pi, so
# they survive between runs; run these from the same directory as before):
#   pi -c           continue this project's most recent session
#   pi -r           pick a session of this project's to resume
#   pi --session <id>   resume a specific session by id

root="$(git rev-parse --show-toplevel 2>/dev/null)"
dir="$PWD"
while :; do
  if [ -x "$dir/.pi-tool/run" ]; then
    exec "$dir/.pi-tool/run" "$@"
  fi
  [ "$dir" = "$root" ] && break   # reached the git repo root; don't climb past it
  [ "$dir" = "/" ] && break       # not in a repo (or hit fs root); stop
  dir="$(dirname "$dir")"
done

# No .pi-tool/run found anywhere up the tree — fall back to running pi in
# Docker, mounting the current directory as the workspace.
image="pi-coding-agent"

# The `RUN printf` line bakes a container-local git excludesfile into the image
# (wired up via core.excludesfile in the `docker run` below): one quoted pattern
# per arg. It keeps pi's own artifacts out of `git status` without touching the
# project's real .gitignore. Add/remove patterns, then run `pi rebuild`.
dockerfile='FROM node:24-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git ripgrep \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent
RUN printf "%s\n" ".pi-tool/" "tags" > /etc/pi-gitignore-global
WORKDIR /workspace
ENTRYPOINT ["pi"]'

# `pi rebuild` rebuilds the fallback image without starting a session, e.g.
# after bumping the pi version. --no-cache forces a fresh npm install; extra
# args are forwarded to `docker build`.
if [ "$1" = "rebuild" ]; then
  shift
  echo "pi: rebuilding Docker image '$image'..." >&2
  printf '%s\n' "$dockerfile" | docker build --no-cache -t "$image" "$@" -
  exit
fi

if ! docker image inspect "$image" >/dev/null 2>&1; then
  echo "pi: building Docker image '$image'..." >&2
  printf '%s\n' "$dockerfile" | docker build -t "$image" - || exit 1
fi

# The "project root": the git repo root when in one, otherwise the current dir.
# Everything below (the workspace mount, per-project sessions, the host-command
# whitelist) keys off this, so it all works the same in non-git directories.
base="${root:-$PWD}"
workspace="$base"

# Carry the host git identity into the container so commits made inside it are
# attributed to the same author as on the host, and point core.excludesfile at
# the container-local ignore list baked into the image (mirrors .pi-tool/run).
run_args=(
  --rm -it
  -v "$workspace":/workspace
  -v "$HOME/.pi":/root/.pi
  -w /workspace
  -e GIT_CONFIG_COUNT=3
  -e GIT_CONFIG_KEY_0=user.name
  -e GIT_CONFIG_VALUE_0="$(git config user.name 2>/dev/null || true)"
  -e GIT_CONFIG_KEY_1=user.email
  -e GIT_CONFIG_VALUE_1="$(git config user.email 2>/dev/null || true)"
  -e GIT_CONFIG_KEY_2=core.excludesfile
  -e GIT_CONFIG_VALUE_2=/etc/pi-gitignore-global
)

# If this repo defines a host-command whitelist, run a per-session broker so pi
# can invoke those commands on the host via `host-run`. The whitelist is mounted
# read-only so pi (which has the repo rw) cannot tamper with what it may run.
broker_pid=""
broker_dir=""
pi_args=()   # extra arguments passed to pi itself (before the user's)

# Give each project its own session store under the persisted ~/.pi mount, so
# `pi -c` / `pi -r` resume THIS project's sessions. pi otherwise keys sessions by
# cwd, which is always /workspace in the container — so without this every
# project would share (and clobber) one session bucket.
session_key="$(printf '%s' "${base#/}" | sed 's#[^A-Za-z0-9._-]#-#g')"
pi_args+=(--session-dir "/root/.pi/agent/sessions/$session_key")

whitelist="$base/.pi-tool/host-commands"
hostrun="$(command -v host-run || true)"
if [ -f "$whitelist" ]; then
  if [ -z "$hostrun" ]; then
    echo "pi: found $whitelist but 'host-run' is not on PATH; host commands disabled" >&2
  elif broker_dir="$(mktemp -d /tmp/pi-broker.XXXXXX)" && [ -d "$broker_dir" ]; then
    pi-broker "$broker_dir" "$base" "$whitelist" &
    broker_pid=$!
    run_args+=(
      -v "$broker_dir":/pi-broker
      -v "$hostrun":/usr/local/bin/host-run:ro
      -v "$whitelist":/workspace/.pi-tool/host-commands:ro
      -e PI_BROKER=/pi-broker
    )

    # Tell pi (via its system prompt) that host-run exists and which commands
    # this repo allows, so awareness is automatic and the repo stays config-free
    # apart from the whitelist itself. Names are parsed from the whitelist.
    names="$(awk -F= '
      /^[[:space:]]*#/ { next }
      /=/ {
        n = $1
        sub(/^[[:space:]]*(raw:)?[[:space:]]*/, "", n)
        sub(/[[:space:]]*$/, "", n)
        if (n != "") { printf "%s%s", sep, n; sep = ", " }
      }' "$whitelist")"
    pi_args+=(--append-system-prompt "You are running inside a locked-down container.
Some commands can be run on the host machine via the \`host-run\` tool, on your PATH:
- \`host-run\` with no arguments lists the commands this project allows.
- \`host-run <name> [args...]\` runs one. Output streams live and the call returns
  the command's exit code; commands may take several minutes.
You cannot run arbitrary host commands — only these named ones.
Available in this project: ${names:-(run host-run with no arguments to see)}")
  else
    broker_dir=""
    echo "pi: could not create broker temp dir; host commands disabled" >&2
  fi
fi

# Stop the broker on exit. The temp dir under /tmp is left for the OS to reap
# (macOS clears stale /tmp entries), which also leaves its request/response logs
# around for debugging a session.
trap '[ -n "$broker_pid" ] && kill "$broker_pid" 2>/dev/null' EXIT

docker run "${run_args[@]}" "$image" "${pi_args[@]}" "$@"
